NODE_ENV=production
PORT=8080
MONGODB_URI=
MONGODB_DB_NAME=vickins_business_os
JWT_SECRET=
JWT_EXPIRES_IN=7d
TUMA_WEBHOOK_SECRET=
SUPPORT_API_KEY=
EXPO_PUSH_ACCESS_TOKEN=
CORS_ORIGINS=
COMMERCE_WEBHOOK_ENCRYPTION_KEY=
AUTH_RESET_CODE_TTL_MINUTES=10
# POST endpoint for the existing SMS/email delivery provider. The payload contains event, recipient, code, expiresAt, and resetUrl.
AUTH_RESET_DELIVERY_URL=
AUTH_RESET_DELIVERY_SECRET=
AUTH_RESET_APP_URL=vickinsbos://
# Keep false in production. Set true only for local/staging testing without a delivery provider.
AUTH_RESET_EXPOSE_DEBUG_CODE=false

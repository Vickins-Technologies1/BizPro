{
  "name": "@vbo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node ../../tools/start-api-prod.cjs",
    "build": "nest build",
    "test:smoke": "ts-node --transpile-only test/tenant-safety.smoke.ts",
    "test:commerce-smoke": "ts-node --transpile-only test/commerce-foundation.smoke.ts",
    "test:financial-smoke": "ts-node --transpile-only test/financial-integrity.smoke.ts",
    "financial:diagnostic": "ts-node --transpile-only scripts/financial-diagnostic.ts",
    "financial:migration:plan": "ts-node --transpile-only scripts/financial-migration-plan.ts",
    "financial:migration:apply": "ts-node --transpile-only scripts/financial-migration-apply.ts",
    "financial:reconcile": "ts-node --transpile-only scripts/financial-reconcile.ts",
    "financial:concurrency-test": "ts-node --transpile-only scripts/financial-concurrency-test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "10.4.2",
    "@vbo/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^3.6.0",
    "mongoose": "^8.5.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.12",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}

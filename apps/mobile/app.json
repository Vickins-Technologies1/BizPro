{
  "expo": {
    "name": "Dira OS",
    "owner": "vickins",
    "slug": "biz-pro",
    "scheme": "vickinsbos",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/brand/dira-os-mobile-icon-safe.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.bizpro.vickins",
      "versionCode": 10,
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/dira-os-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.vickins.businessos",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allows the app to scan product barcodes.",
        "NSBluetoothAlwaysUsageDescription": "Allows the app to connect to Bluetooth receipt printers.",
        "NSBluetoothPeripheralUsageDescription": "Allows the app to connect to Bluetooth receipt printers."
      }
    },
    "splash": {
      "image": "./assets/brand/dira-os-logo.png",
      "backgroundColor": "#F5F8FC",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "a1608b80-e48e-4bb6-ab68-999353b0d243"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Biz Pro to use your camera to scan product barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildToolsVersion": "35.0.0",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "ndkVersion": "28.1.13356709"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "./plugins/withPatchedBluetoothEscpos"
    ]
  }
}
